# TypeSafe AI / Jev Configuration
# Get your API key from TypeSafe AI or OpenRouter
TYPESAFE_API_KEY=ts_your_api_key_here

# Optional: Custom endpoint (default: https://api.typesafe.ai)
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# Or via OpenRouter:
# TYPESAFE_BASE_URL=https://openrouter.ai/api

# Optional: Default model (default: jev-1)
# TYPESAFE_DEFAULT_MODEL=jev-1
